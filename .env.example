# =================================================================
# NodalConnector Monorepo Environment Configuration Template
# =================================================================
# Copy this file to:
#   - server/.env for backend service configuration
#   - client/.env for frontend single-page application configuration
#
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# =================================================================

# -----------------------------------------------------------------
# 1. Backend Server Configuration (server/.env)
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_NAME=NodalConnector
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.nodalconnector.com

# Database Connection (MongoDB Replica Set or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/nodalconnector

# Authentication & Cryptographic Keys
# Generate high-entropy 256-bit secrets via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_base64_string
JWT_EXPIRES_IN=24h

# Bootstrap Administrator (Initial system setup only)
ADMIN_EMAIL=admin@nodalconnector.in
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Cache & Message Broker (Optional Redis instance)
REDIS_URL=redis://localhost:6379

# Cloud Storage (Cloudinary credentials for avatars & documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI & LLM Inference APIs
GROQ_API_KEY=gsk_your_groq_api_key_here

# Notification & SMTP Services
SUPPORT_EMAIL=support@nodalconnector.in
EMAIL_FROM_ADDRESS=noreply@nodalconnector.in

# Option A: Gmail SMTP
GMAIL_USER=your_email@example.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password_without_spaces

# Option B: Enterprise SMTP
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@nodalconnector.in
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# -----------------------------------------------------------------
# 2. Frontend Client Configuration (client/.env)
# -----------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_BACKEND_URL=http://localhost:5000
VITE_APP_NAME=NodalConnector
VITE_SUPPORT_EMAIL=support@nodalconnector.in
